{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker serving the built Storybook at nuk.brentstees.com.
  // Deploy with `pnpm deploy:storybook` from the repository root; nothing in CI deploys.
  "name": "nuk-storybook",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./storybook-static",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "nuk.brentstees.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
