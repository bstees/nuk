---
import type { GetStaticPaths } from 'astro';
import type { DigestIssue } from '@nuk-ui/editorial';
import EntryCard from '../../components/EntryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayDate, getIssues } from '../../lib/content';

export const getStaticPaths = (() => getIssues().map((issue) => ({ params: { slug: issue.slug }, props: { issue } }))) satisfies GetStaticPaths;

const { issue } = Astro.props as { issue: DigestIssue };
---

<BaseLayout title={issue.title} description={issue.dek} canonicalPath={`/issue/${issue.slug}/`} article>
  <header class="page-intro page-intro--issue shell">
    <p class="eyebrow">Issue {String(issue.issueNumber).padStart(3, '0')} · <time datetime={issue.publishedAt}>{displayDate(issue.publishedAt)}</time></p>
    <h1>{issue.title.replace('Signal / Interface — ', '')}</h1>
    <p>{issue.dek}</p>
  </header>
  <section class="issue shell" aria-label="Issue readings">
    <div class="entry-list">
      {issue.entries.map((entry, index) => <EntryCard entry={entry} number={index + 1} />)}
    </div>
  </section>
</BaseLayout>
