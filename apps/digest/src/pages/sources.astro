---
import manifest from '@nuk-ui/editorial/sources';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicLabel } from '../lib/content';

const sources = manifest.sources.filter((source) => source.id !== 'fixture-platform-notes');
---

<BaseLayout title="Sources — Signal / Interface" description="The versioned Signal / Interface source allowlist and its editorial caveats." canonicalPath="/sources/">
  <header class="page-intro shell">
    <p class="eyebrow">Source register · v1</p>
    <h1>Known inputs, named limits.</h1>
    <p>The source list is deliberately short. Inclusion means “eligible for review,” not endorsement or automatic publication.</p>
  </header>
  <div class="source-list shell">
    {sources.map((source) => (
      <article>
        <div><p class="eyebrow">{source.primary ? 'Primary source' : 'Publisher'}</p><h2><a href={source.siteUrl}>{source.name}<span aria-hidden="true">↗</span></a></h2></div>
        <p>{source.note}</p>
        <ul class="topic-list" aria-label={`${source.name} topics`}>{source.topics.map((topic) => <li>{topicLabel(topic)}</li>)}</ul>
      </article>
    ))}
  </div>
</BaseLayout>
