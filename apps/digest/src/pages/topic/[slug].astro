---
import type { GetStaticPaths } from 'astro';
import type { Topic } from '@nuk-ui/editorial';
import EntryCard from '../../components/EntryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entriesForTopic, getTopics, topicLabel } from '../../lib/content';

export const getStaticPaths = (() => getTopics().map((topic) => ({ params: { slug: topic }, props: { topic } }))) satisfies GetStaticPaths;
const { topic } = Astro.props as { topic: Topic };
const records = entriesForTopic(topic);
---

<BaseLayout title={`${topicLabel(topic)} — Signal / Interface`} description={`Cited Signal / Interface readings about ${topicLabel(topic)}.`} canonicalPath={`/topic/${topic}/`}>
  <header class="page-intro shell">
    <p class="eyebrow">Topic</p>
    <h1>{topicLabel(topic)}</h1>
    <p>{records.length} {records.length === 1 ? 'reading' : 'readings'} across approved issues.</p>
  </header>
  <section class="issue shell" aria-label={`${topicLabel(topic)} readings`}>
    <div class="entry-list">
      {records.map(({ entry }, index) => <EntryCard entry={entry} number={index + 1} compact />)}
    </div>
  </section>
</BaseLayout>
