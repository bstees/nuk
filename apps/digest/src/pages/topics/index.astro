---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entriesForTopic, getTopics, topicLabel } from '../../lib/content';

const topics = getTopics();
---

<BaseLayout title="Topics — Signal / Interface" description="Browse Signal / Interface by editorial topic." canonicalPath="/topics/">
  <header class="page-intro shell">
    <p class="eyebrow">Topics</p>
    <h1>Follow the thread.</h1>
    <p>Topics are deliberately broad. They help with orientation; they are not a taxonomy pretending to be truth.</p>
  </header>
  <div class="topic-grid shell">
    {topics.map((topic, index) => (
      <a class="topic-tile" href={`/topic/${topic}/`}>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <strong>{topicLabel(topic)}</strong>
        <small>{entriesForTopic(topic).length} {entriesForTopic(topic).length === 1 ? 'reading' : 'readings'}</small>
      </a>
    ))}
  </div>
</BaseLayout>
