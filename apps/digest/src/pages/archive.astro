---
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayDate, getIssues } from '../lib/content';

const issues = getIssues();
---

<BaseLayout title="Archive — Signal / Interface" description="Every approved issue of Signal / Interface." canonicalPath="/archive/">
  <header class="page-intro shell">
    <p class="eyebrow">Archive</p>
    <h1>Every signal, still cited.</h1>
    <p>Approved issues remain stable records. Drafts never appear here.</p>
  </header>
  <div class="archive shell">
    {issues.map((issue) => (
      <article class="archive-row">
        <p class="archive-row__number">No. {String(issue.issueNumber).padStart(3, '0')}</p>
        <div>
          <h2><a href={`/issue/${issue.slug}/`}>{issue.title}</a></h2>
          <p>{issue.dek}</p>
        </div>
        <p><time datetime={issue.publishedAt}>{displayDate(issue.publishedAt)}</time><br />{issue.entries.length} readings</p>
      </article>
    ))}
  </div>
</BaseLayout>
