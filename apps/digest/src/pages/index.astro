---
import EntryCard from '../components/EntryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayDate, getIssues } from '../lib/content';

const issues = getIssues();
const latest = issues[0];
if (!latest) throw new Error('At least one approved issue is required for the digest build.');
---

<BaseLayout title="Signal / Interface" description={latest.dek} canonicalPath="/">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero__issue">
      <p class="eyebrow">Independent field notes · Issue {String(latest.issueNumber).padStart(3, '0')}</p>
      <h1 id="hero-title"><span>Useful signals.</span><span>Human judgment.</span></h1>
    </div>
    <div class="hero__note">
      <p>{latest.dek}</p>
      <p class="edition"><time datetime={latest.publishedAt}>{displayDate(latest.publishedAt)}</time><span>{latest.entries.length} readings</span></p>
    </div>
    <div class="hero__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
  </section>

  <section class="issue shell" aria-labelledby="latest-heading">
    <div class="section-heading">
      <p class="eyebrow">The weekly edit</p>
      <h2 id="latest-heading">Read with context</h2>
      <p>Short, cited interpretations. Original reporting and research stay one link away.</p>
    </div>
    <div class="entry-list">
      {latest.entries.map((entry, index) => <EntryCard entry={entry} number={index + 1} />)}
    </div>
  </section>

  <aside class="principle-band" aria-labelledby="principle-heading">
    <div class="shell principle-band__inner">
      <p class="eyebrow">Editorial principle</p>
      <blockquote id="principle-heading">Automation can find the pile. It does not decide what deserves your attention.</blockquote>
      <a class="text-link" href="/about/">How an issue is made <span aria-hidden="true">→</span></a>
    </div>
  </aside>
</BaseLayout>
