{
  "name": "@nuk-ui/elements",
  "version": "0.1.0",
  "description": "Semantic, accessible nuk-prefixed custom elements.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./prefix": {
      "types": "./dist/prefix.d.ts",
      "default": "./dist/prefix.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "publint"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "publint": "0.3.25",
    "vitest": "5.0.5"
  }
}
