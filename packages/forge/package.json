{
  "name": "@nuk-ui/forge",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed clean-room component translation proof of concept.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nuk-forge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "intake",
    "policies",
    "prompts",
    "schemas",
    "skills",
    "specs",
    "templates",
    "README.md"
  ],
  "scripts": {
    "analyze:fixtures": "node src/cli.ts fixtures",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm proof",
    "proof": "node src/cli.ts proof --work-dir work/proof",
    "test": "node --test --experimental-test-coverage src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
