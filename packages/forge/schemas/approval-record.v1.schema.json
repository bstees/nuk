{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuk-ui:forge:approval-record:v1",
  "title": "Human approval record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "componentId",
    "candidate",
    "spec",
    "analysisReport",
    "conformanceReport",
    "provenanceReport",
    "status",
    "reviewer",
    "reviewedAt",
    "rationale",
    "attestation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": "string" },
    "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$" },
    "candidate": { "$ref": "#/$defs/binding" },
    "spec": { "$ref": "#/$defs/binding" },
    "analysisReport": { "$ref": "#/$defs/binding" },
    "conformanceReport": { "$ref": "#/$defs/binding" },
    "provenanceReport": { "$ref": "#/$defs/binding" },
    "status": { "enum": ["pending", "approved", "rejected"] },
    "reviewer": { "type": ["string", "null"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "rationale": { "type": ["string", "null"] },
    "attestation": { "type": ["string", "null"] }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
