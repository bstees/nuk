{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuk-ui:forge:component-spec:v1",
  "title": "Normalized component specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "namespace",
    "summary",
    "provenance",
    "semantics",
    "states",
    "events",
    "behavior",
    "accessibility",
    "security",
    "acceptanceTests",
    "generation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-$",
      "description": "Configurable custom-element prefix including its trailing hyphen; nuk- is the default."
    },
    "summary": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intakeRecord", "sourceIds"],
      "properties": {
        "intakeRecord": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostElement", "permittedRoles", "requiredParts"],
      "properties": {
        "hostElement": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$" },
        "permittedRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredParts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "selector", "nativeElement", "requirements"],
            "properties": {
              "name": { "type": "string" },
              "selector": { "type": "string" },
              "nativeElement": { "type": "string" },
              "requirements": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values", "initial"],
        "properties": {
          "name": { "type": "string" },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "initial": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bubbles", "composed", "detail"],
        "properties": {
          "name": { "type": "string" },
          "bubbles": { "type": "boolean" },
          "composed": { "type": "boolean" },
          "detail": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "accessibility": { "type": "object" },
    "security": {
      "type": "object",
      "required": ["allowedCapabilities", "forbiddenCapabilities"],
      "properties": {
        "allowedCapabilities": { "type": "array", "items": { "type": "string" } },
        "forbiddenCapabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptanceTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "assertion"],
        "properties": {
          "id": { "type": "string" },
          "level": { "enum": ["accessibility", "behavior", "conformance", "static"] },
          "assertion": { "type": "string" }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatorVersion", "templateId", "promptVersion", "skillVersion"],
      "properties": {
        "generatorVersion": { "const": "1.0.0" },
        "templateId": { "const": "dismissible-alert.v1" },
        "promptVersion": { "const": "v1" },
        "skillVersion": { "const": "v1" }
      }
    }
  }
}
