{
  "name": "@nuk-ui/theme",
  "version": "0.1.0",
  "description": "Optional light and dark semantic themes for the nuk component system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nuk-ui/tokens": "workspace:*"
  }
}
